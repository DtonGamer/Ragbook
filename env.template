# Netlify Environment Variables Template
# Copy this file to .env.local for local development
# Set these variables in your Netlify dashboard under Site Settings > Environment Variables

# ===========================================
# REQUIRED - Supabase Configuration
# ===========================================
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# REQUIRED for Edge Functions (set in Supabase secrets, not in .env.local)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# REQUIRED - Google AI API Keys
# ===========================================
# Get these from Google AI Studio (https://aistudio.google.com/)
# Both keys are required for different functions
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# REQUIRED - Payment Gateway Secrets (set in Supabase secrets, not in .env.local)
# ===========================================
# Monnify Payment Gateway (replace Paystack)
MONNIFY_SECRET_KEY=your_monnify_secret_key_here

# ===========================================
# OPTIONAL - Web Search API Keys
# ===========================================
# These are used for web search fallbacks when knowledge base doesn't have good matches
# You only need this if you want web search functionality

# Tavily (https://tavily.com/)
TAVILY_API_KEY=your_tavily_key_optional

# ===========================================
# OPTIONAL - App Configuration
# ===========================================
VITE_APP_NAME=RUG Bot
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AI-Powered Knowledge Assistant

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# These are used by the security implementations in edge functions
# Set these in Supabase secrets for production

# Rate Limiting Configuration (hardcoded in functions)
# Note: Rate limits are currently hardcoded in the edge functions:
# - Chat: 10 requests/minute per user/IP
# - File Upload: 5 requests/minute per user/IP
# These are not configurable via environment variables

# File Upload Security
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,txt,doc,docx,md,rtf,csv,xls,xlsx
ENABLE_FILE_SIGNATURE_VALIDATION=true
ENABLE_MALICIOUS_CONTENT_SCANNING=true

# Session Management
SESSION_TIMEOUT_MINUTES=30
REFRESH_TOKEN_BEFORE_EXPIRY_MINUTES=5
ENABLE_ACTIVITY_TRACKING=true

# Security Logging
LOG_LEVEL=INFO
ENABLE_SECURITY_EVENT_LOGGING=true
ENABLE_ANOMALY_DETECTION=true
LOG_RETENTION_DAYS=90

# Input Validation
MAX_MESSAGE_LENGTH=10000
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_XSS_PREVENTION=true
ENABLE_SQL_INJECTION_PREVENTION=true

# ===========================================
# OPTIONAL - Vector Search Configuration
# ===========================================
VITE_VECTOR_DIMENSIONS=768
VITE_SIMILARITY_THRESHOLD=0.65
VITE_MAX_MATCH_COUNT=5

# ===========================================
# OPTIONAL - File Upload Configuration
# ===========================================
VITE_MAX_FILE_SIZE_MB=10
VITE_SUPPORTED_FILE_TYPES=pdf,txt,md,docx

# ===========================================
# OPTIONAL - Payment Gateway Configuration
# ===========================================
# Monnify Payment Gateway (replace Paystack)
VITE_MONNIFY_CONTRACT_CODE=your_monnify_contract_code_here
VITE_MONNIFY_PUBLIC_KEY=your_monnify_public_key_here

# ===========================================
# OPTIONAL - Chat Configuration
# ===========================================
VITE_MAX_CONVERSATION_HISTORY=50
VITE_RATE_LIMIT_PER_MINUTE=60

# ===========================================
# OPTIONAL - Development/Testing
# ===========================================
# Only set these in development or testing environments
# NODE_ENV=production
# VITE_DEBUG=false
